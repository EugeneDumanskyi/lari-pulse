BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_KLINE_LIMIT=100
BINANCE_DERIVATIVES_HISTORY_LIMIT=30
FRED_BASE_URL=https://fred.stlouisfed.org
DATABASE_PATH=data/laripulse.sqlite
# Optional headless seed for the first admin. Used only when both are set and
# the database has no users; otherwise create the admin at /setup.
LARIPULSE_ADMIN_EMAIL=
LARIPULSE_ADMIN_PASSWORD=
LARIPULSE_SESSION_MAX_AGE_SECONDS=2592000
LARIPULSE_INVITE_MAX_AGE_SECONDS=604800
SCHEDULER_ENABLED=false
COLLECT_INTERVAL_SECONDS=60
MACRO_SCHEDULER_ENABLED=false
MACRO_REFRESH_INTERVAL_SECONDS=86400
LIQUIDITY_RUNTIME_ENABLED=false
LIQUIDATIONS_RETENTION_HOURS=48
BINANCE_LIQUIDATION_STREAM_URL=wss://fstream.binance.com/ws/!forceOrder@arr
